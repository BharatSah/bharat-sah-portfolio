# EmailJS configuration (client-side only — never commit real secrets)
# Copy this file to ".env" and fill in the values from your EmailJS dashboard.
# These are read by Vite as import.meta.env.VITE_* and are exposed to the browser,
# so they must be public keys / IDs only — never private API secrets.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Optional: the URL of the resume PDF. Replace with a real link or local file in /public.
VITE_RESUME_URL=#resume-download
